{
  "expo": {
    "name": "AI News",
    "slug": "ai-news",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "ainews",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#00020a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ainews.app",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.ainews.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00020a"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00e5ff",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "◈ AI NEWS"
        }
      ]
    ],
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#00e5ff",
      "androidMode": "default"
    }
  }
}
